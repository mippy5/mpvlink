{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build plugin (debug)",
      "type": "shell",
      "command": "make build PROFILE=debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build plugin (release)",
      "type": "shell",
      "command": "make build",
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
