{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build plugin (debug)",
      "type": "shell",
      "command": "make build PROFILE=debug",
      // On Windows, cargo already names the output mpvlink.dll, the name mpv
      // wants, so there's nothing to copy: target\debug\mpvlink.dll.
      "windows": { "command": "cargo build -p mpvlink" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build plugin (release)",
      "type": "shell",
      "command": "make build",
      "windows": { "command": "cargo build -p mpvlink --release" },
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
